#include <stdio.h>
#include <stdlib.h>
struct node 
{int data;
struct node *next;};
struct node *front = NULL;
struct node *rear = NULL;

void insert(int x)
{struct node *p;
p= (struct node *) malloc (sizeof(struct node));
p->data=x;
p->next=NULL;
if (front==NULL)
    {front=rear=p;}
else
    {rear->next=p;rear=p;}
printf("inserted \n");
}

void delete()
{struct node *temp;
temp=front;
if (front ==NULL)
    {printf("queue already empty \n");return;}
printf("%d is deleted,front->data");
front=front->next;
if (front==NULL)
    {rear=NULL;}
free(temp);
}

void display()
{struct node *temp;
temp=front;
if (front==NULL)
    {printf("empty squeue \n");return;}

printf("queue is: ");
while(temp != NULL)
    {printf("%d ",temp->data); temp=temp->next;}
printf("\n");
}

int main()
{int ch,x;
while(1)
    {printf("1.insert\n 2.delete\n 3.display \n\t ENTER YOUR CHOICE");
    scanf("%d",&ch);
    switch(ch)
    {case 1: {printf("enter item u want to add");
              scanf("%d",&x);
              insert(x);
              break;}
    case 2: {delete();break;}
    case 3: {display();break;}
    case 4: {exit(0);}
    default: printf("invalid choice");
    }
    
}return 0;
}



















