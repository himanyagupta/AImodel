#include <stdio.h>
#include <stdlib.h>
struct node 
{int data;
struct node *next;};
struct node *top = NULL;

void insert(int x)
{struct node *p;
p= (struct node *) malloc (sizeof(struct node));
p->data=x;
p->next=top;
top=p;
printf("value inserted successfully \n");}

void delete()
{struct node *temp;
if (top==NULL)
    {printf("empty stack \n"); return;}
temp=top;
printf("%d is deleted",top->data);
top=top->next;
free(temp);}

void display()
{struct node *temp;
if (top==NULL)
    {printf("empty stack \n");return;}
temp=top;
printf("stack is: ");
while(temp != NULL)
    {printf("%d ",temp->data); temp=temp->next;}
printf("\n");
}

int main()
{int ch,x;
while(1)
    {printf("1.insert\n 2.delete\n 3.display \n\t ENTER YOUR CHOICE");
    scanf("%d",&ch);
    switch(ch)
    {case 1: {printf("enter item u want to add");
              scanf("%d",&x);
              insert(x);
              break;}
    case 2: {delete();break;}
    case 3: {display();break;}
    case 4: {exit(0);}
    default: printf("invalid choice");
    }
    
}return 0;
}



















