#include <stdio.h>
#include <stdlib.h>
struct node 
{int data;
struct node *prev;
struct node *next;};

struct node *start=NULL;
struct node *prev=NULL;
struct node *tail= NULL;

struct node *newnode()
{return (struct node*)malloc (sizeof(struct node));}

void insert_begin(int x)
{
    struct node *p= newnode();
    p-> data=x;
    p->prev= NULL;
    p->next=start;
    if (start==NULL)
    {
        start=tail=p;
    }
   
    start->prev=p;
    start=p;
}

void insert_end(int x)
{
   struct node *p= newnode();
    p-> data=x;
    p->next=NULL;
    p->prev=tail;
    if (tail==NULL)
    {
        start=tail=p;
    }
    tail->next=p;
    tail=p;
}

void delete_begin()
{
    struct node *temp;
    if (start==NULL)
    {
        printf("empty \n");return;
    }
    if (start->next ==NULL)
    {
        free(start);
        start=tail=NULL;
        return;
    }
    temp=start;
    start=start->next;
    start->prev=NULL;
    free(temp);
}

void delete_end()
{
    struct node *temp;
    if (tail==NULL)
    {printf("empty");return;}
    temp=tail;
    tail=tail->prev;
    if (tail == NULL) 
    {
        start = NULL;
    } 
    else 
    {
        tail->next = NULL;
    }

    free(temp);
}

void forward_traversal()
{
    struct node *q=start;
    while(q!= NULL)
    {
        printf("%d \n",q->data);q=q->next;
    }

}
void backward_traversal()
{
    struct node *q=tail;
    while (q!= NULL)
    {
        printf("%d ",q->data);
        q=q->prev;
    }
}
